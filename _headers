/main.js
  Cache-Control: no-store

/shared.js
  Cache-Control: no-store

/
  Cache-Control: no-store

/index.html
  Cache-Control: no-store

/media/*
  Cache-Control: public, max-age=31536000, immutable

# Icons: short cache + revalidate. "immutable" here means a favicon change can
# never reach a returning visitor, which is exactly what happened.
/favicon.svg
  Cache-Control: public, max-age=3600, must-revalidate

/favicon-96.png
  Cache-Control: public, max-age=3600, must-revalidate

/mask-icon.svg
  Cache-Control: public, max-age=3600, must-revalidate

/apple-touch-icon.png
  Cache-Control: public, max-age=86400, must-revalidate

/og-image.png
  Cache-Control: public, max-age=86400, must-revalidate
